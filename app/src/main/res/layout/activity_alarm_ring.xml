<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:gravity="center" android:background="#6C5CE7"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="24dp">
    <TextView android:id="@+id/tvRingLabel" android:text="ALARM!" android:textSize="36sp" android:textStyle="bold" android:textColor="#fff" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/tvRingInfo" android:text="Volume Down dabao mute karne ke liye" android:textColor="#fff" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnSnooze" android:text="Snooze (Repeat)" android:layout_marginTop="32dp" android:layout_width="match_parent" android:layout_height="56dp"/>
    <Button android:id="@+id/btnStop" android:text="STOP ALARM" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="56dp"/>
</LinearLayout>
